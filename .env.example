# Stripe (get test keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...

# --- Inquiry email (Send inquiry form -> /api/inquiry) ---
# If these SMTP vars are left blank, the app runs in a SAFE DEV MODE:
# emails are NOT delivered to real inboxes — they are captured by an
# Ethereal preview account (a preview URL is printed to the server log),
# or simply logged to the console when offline.
#
# To send REAL emails, fill these in (.env.local, never commit real secrets):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# "From" address shown to recipients (use a domain you're allowed to send from)
MAIL_FROM="Poble <sales@poble.com.au>"
# Where a copy of every enquiry is sent
INQUIRY_NOTIFY_EMAIL=inho.kim@posnet.com.au
